# Copy to deployment/.env. Never commit the copy.
POSTGRES_PASSWORD=change-me
IP_SALT=change-me-to-a-long-random-string

# Where browsers reach the API, and which site may call it.
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# color = untrained placeholder. maskrcnn:/artifacts/model.pt = the trained model.
DETECTOR_SPEC=color
BENCHMARKS_PATH=/artifacts/benchmarks.json

# Set to 1 when the API sits behind your own reverse proxy.
TRUST_PROXY=0

MAX_UPLOAD_MB=200
MAX_VIDEO_SECONDS=30
MAX_VIDEO_SIDE=1920
MAX_UPLOADS_PER_DAY=5
MAX_QUEUE=20
RETENTION_DAYS=7

# Optional object storage. Leave empty to use the shared volume.
S3_BUCKET=
S3_ENDPOINT=
