# Image for both the API and the worker; docker-compose picks the command.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
# CPU torch keeps the image small. Change the index URL for a GPU worker.
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install ".[ml,postgres,s3]"
RUN useradd --system --uid 1001 avia && mkdir -p /data && chown avia /data
USER avia
EXPOSE 8000
CMD ["uvicorn", "avia.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
